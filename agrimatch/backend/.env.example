APP_NAME="AgriMatch PH"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Matches the database created by database/agrimatch_db.sql (XAMPP defaults)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agrimatch_db
DB_USERNAME=root
DB_PASSWORD=
# Session time zone — must match the dump (and APP_TIMEZONE) so timestamps and the audit hash chain line up.
DB_TIMEZONE=+08:00

# --- Sanctum SPA authentication (cookie + CSRF) -------------------------
# The React app must be served from one of these hosts (the Vite dev server
# proxies /api and /sanctum to Laravel, so cookies stay first-party).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174,localhost:4173,127.0.0.1:4173,localhost,127.0.0.1
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Keep the session cookie host-only for localhost and 127.0.0.1 development.
SESSION_DOMAIN=
SESSION_COOKIE=agrimatch_session_v2
# Set to true in production (HTTPS only)
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
# Use "database" + `php artisan queue:work` in production so SMS sends never block requests.
QUEUE_CONNECTION=sync

# --- Semaphore SMS gateway (https://semaphore.co) -------------------------
# Empty key = messages are recorded in sms_logs with status "skipped".
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=AGRIMATCH

# --- Fuel surcharge baselines (PHP / liter) -------------------------------
FUEL_BASELINE_DIESEL=56.00
FUEL_BASELINE_GASOLINE=60.00
