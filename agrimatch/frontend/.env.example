# Laravel API base. Keep it relative ("/api/v1") so requests go through the
# Vite proxy (dev) or the same web server (production) — required for the
# Sanctum session cookie + CSRF protection to work.
VITE_API_URL=/api/v1
# Where the Vite dev/preview proxy forwards /api and /sanctum
VITE_PROXY_TARGET=http://127.0.0.1:8000
